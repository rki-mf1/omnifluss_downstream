nextflow_process {

    name "Test Process NEXTCLADE_DATASET_PROVENANCE"
    script "../main.nf"
    process "NEXTCLADE_DATASET_PROVENANCE"

    tag "modules"
    tag "modules_local"
    tag "nextclade_dataset_provenance"


    test("sarscov2 default") {
        setup {
            run("NEXTCLADE_DATASETGET") {
                script "../../../nf-core/nextclade/datasetget/main.nf"
                process {
                    """
                    input[0] = 'nextstrain/sars-cov-2/wuhan-hu-1/orfs'
                    input[1] = '2024-01-16--20-31-02Z'
                    """
                }
            }
            run("NEXTCLADE_RUN") {
                script "../../../nf-core/nextclade/run/main.nf"
                process {
                    """
                    input[0] = [[id: 'test'],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                        ]
                    input[1] = NEXTCLADE_DATASETGET.out.dataset
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = NEXTCLADE_RUN.out.dataset_pathogen_json.join(NEXTCLADE_RUN.out.csv, by: 0)
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("stub run") {
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test'],
                    file(params.modules_testdata_base_path + 'generic/csv/test.csv', checkIfExists: true), // toy data, no senseful content
                    file(params.modules_testdata_base_path + 'generic/config/wittyer_config.json', checkIfExists: true) // toy data, no senseful content
                ]
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
