/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

params {
    // order of extension and tags has to be the same
    get_nextclade_dataset      = true
    nextclade_sort_extensions = "flu/h1n1pdm/ha/sequences.fasta,flu/h1n1pdm/na/sequences.fasta,flu/h3n2/ha/sequences.fasta,flu/h3n2/na/sequences.fasta,flu/vic/ha/sequences.fasta,flu/vic/na/sequences.fasta"
    nextclade_sort_tags       = "H1N1_HA,H1N1_NA,H3N2_HA,H3N2_NA,H0N0_HA,H0N0_NA"
    nextclade_dataset_tags    = "flu_h1n1pdm_ha,flu_h1n1pdm_na,flu_h3n2_ha,flu_h3n2_na,flu_vic_ha,flu_vic_na"

    // mapping between nextclade reference name and inv tags
    mapping_flu_h1n1pdm_ha     = "H1N1_HA"
    mapping_flu_h1n1pdm_na     = "H1N1_NA"
    mapping_flu_h3n2_ha        = "H3N2_HA"
    mapping_flu_h3n2_na        = "H3N2_NA"
    mapping_flu_vic_ha         = "H0N0_HA"
    mapping_flu_vic_na         = "H0N0_NA"

    // pre-downloaded datasets (used when get_nextclade_dataset = false)
    dataset_H3N2_HA            = null
    dataset_H3N2_NA            = null
    dataset_H1N1_HA            = null
    dataset_H1N1_NA            = null
    dataset_H0N0_HA            = null
    dataset_H0N0_NA            = null
}
